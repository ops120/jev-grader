# TypeSafe / JEV API Key
# 1. 复制本文件为 .env      2. 填入自己的 Key      3. .env 已被 .gitignore 排除，不会入库
# 申请地址: https://console.typesafe.ai/keys
jevkey=apikey_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 抄题端点（新卷 PDF 自动入库用；不加也能跑已接入的卷）----------
# 任何 OpenAI 兼容的多模态服务均可，例如：
#   阿里百炼  https://dashscope.aliyuncs.com/compatible-mode/v1  + qwen-vl-plus
#   小米 MiMo https://token-plan-cn.xiaomimimo.com/v1            + mimo-v2.5
TRANSCRIBE_BASE_URL=
TRANSCRIBE_MODEL=
TRANSCRIBE_API_KEY=

